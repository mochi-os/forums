msgstr "ໄຟລ໌ແນບຂອງທ່ານຈະສູນຫາຍ."

#: src/features/forums/components/edit-post-dialog.tsx
msgid "Your changes will be lost."
msgstr "ການປ່ຽນແປງຂອງເຈົ້າຈະຫາຍໄປ."

#: ../../../lib/web/src/components/comment-composer.tsx
msgid "Your text and attachments will be lost."
msgstr "ຂໍ້ຄວາມ ແລະໄຟລ໌ແນບຂອງທ່ານຈະສູນຫາຍ."

#: ../../../lib/web/src/components/comment-composer.tsx
msgid "Your text will be lost."
msgstr "ຂໍ້ຄວາມຂອງເຈົ້າຈະຫາຍໄປ."
